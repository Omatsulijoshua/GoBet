datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id            String   @id @default(uuid())
  walletAddress String   @unique
  role          Role     @default(USER)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  bets          Bet[]
  transactions  Transaction[]
}

enum Role {
  USER
  ADMIN
}

model Match {
  id          String   @id @default(uuid())
  homeTeam    String
  awayTeam    String
  startTime   DateTime
  sport       String
  status      MatchStatus @default(PENDING)
  oddsHome    Float
  oddsAway    Float
  oddsDraw    Float?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  bets        Bet[]
}

enum MatchStatus {
  PENDING
  LIVE
  COMPLETED
  CANCELLED
}

model Market {
  id          String   @id @default(uuid())
  question    String
  endDate     DateTime
  status      MarketStatus @default(OPEN)
  yesPrice    Float    @default(0.5)
  noPrice     Float    @default(0.5)
  totalVolume Float    @default(0)
  outcome     Boolean? // true = YES, false = NO
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  bets        Bet[]
}

enum MarketStatus {
  OPEN
  CLOSED
  RESOLVED
}

model Bet {
  id          String   @id @default(uuid())
  user        User     @relation(fields: [userId], references: [id])
  userId      String
  amount      Float
  type        BetType
  status      BetStatus @default(PENDING)
  
  // For Sports
  match       Match?   @relation(fields: [matchId], references: [id])
  matchId     String?
  selectedOutcome String? // HOME, AWAY, DRAW
  odds        Float?

  // For Prediction Markets
  market      Market?  @relation(fields: [marketId], references: [id])
  marketId    String?
  position    Boolean? // true for YES, false for NO
  priceAtBet  Float?

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

enum BetType {
  SPORTS
  PREDICTION
}

enum BetStatus {
  PENDING
  WON
  LOST
  REFUNDED
}

model Transaction {
  id          String   @id @default(uuid())
  user        User     @relation(fields: [userId], references: [id])
  userId      String
  amount      Float
  type        TxType
  txHash      String   @unique
  status      TxStatus @default(PENDING)
  createdAt   DateTime @default(now())
}

enum TxType {
  DEPOSIT
  WITHDRAWAL
  BET_PAYOUT
}

enum TxStatus {
  PENDING
  COMPLETED
  FAILED
}
